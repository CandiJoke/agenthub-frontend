{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node", "vite/client"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "node_modules/.tmp/contracts",
    "noEmitOnError": true,
    "jsx": "react-jsx"
  },
  "include": ["contracts/**/*.ts", "contracts/**/*.tsx"]
}
